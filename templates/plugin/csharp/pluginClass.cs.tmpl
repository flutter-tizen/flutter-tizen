using System.Collections.Generic;
using System.Threading.Tasks;
using Tizen.Flutter.Embedding;
using Tizen.System;

namespace {{tizenNamespace}}
{
    public class {{pluginClass}} : IFlutterPlugin
    {
        private BasicMessageChannel<object> _getPlatformVersionChannel;

        public void OnAttachedToEngine(IFlutterPluginBinding binding)
        {
            // Implements {{pluginClass}}Api in pigeon/messages.dart. Pigeon does not
            // generate C# code, so the channel name and the reply format
            // ([result] or [code, message, details]) follow lib/src/messages.g.dart.
            _getPlatformVersionChannel = new BasicMessageChannel<object>(
                "dev.flutter.pigeon.{{projectName}}.{{pluginClass}}Api.getPlatformVersion",
                StandardMessageCodec.Instance, binding.BinaryMessenger);
            _getPlatformVersionChannel.SetMessageHandler(
                message => Task.FromResult<object>(new List<object> { GetPlatformVersion() }));
        }

        public void OnDetachedFromEngine()
        {
            _getPlatformVersionChannel.SetMessageHandler(null);
            _getPlatformVersionChannel = null;
        }

        public string GetPlatformVersion()
        {
            if (Information.TryGetValue<string>("http://tizen.org/feature/platform.version", out string version))
            {
                return version;
            }
            return "Unknown";
        }
    }
}
