#include "{{projectName}}_plugin.h"

// For getPlatformVersion; remove unless needed for your plugin implementation.
#include <system_info.h>

#include <flutter/basic_message_channel.h>
#include <flutter/plugin_registrar.h>
#include <flutter/standard_message_codec.h>

#include <memory>
#include <string>

#include "log.h"

namespace {

class {{pluginClass}} : public flutter::Plugin {
 public:
  static void RegisterWithRegistrar(flutter::PluginRegistrar *registrar) {
    // Implements {{pluginClass}}Api in pigeon/messages.dart. The channel name
    // and the reply format ([result] or [code, message, details]) follow
    // lib/src/messages.g.dart.
    flutter::BasicMessageChannel<flutter::EncodableValue> channel(
        registrar->messenger(),
        "dev.flutter.pigeon.{{projectName}}.{{pluginClass}}Api."
        "getPlatformVersion",
        &flutter::StandardMessageCodec::GetInstance());
    channel.SetMessageHandler(
        [](const flutter::EncodableValue &,
           const flutter::MessageReply<flutter::EncodableValue> &reply) {
          reply(GetPlatformVersion());
        });

    registrar->AddPlugin(std::make_unique<{{pluginClass}}>());
  }

 private:
  static flutter::EncodableValue GetPlatformVersion() {
    char *value = nullptr;
    int ret = system_info_get_platform_string(
        "http://tizen.org/feature/platform.version", &value);
    if (ret != SYSTEM_INFO_ERROR_NONE) {
      return flutter::EncodableValue(flutter::EncodableList{
          flutter::EncodableValue(std::to_string(ret)),
          flutter::EncodableValue("Failed to get platform version."),
          flutter::EncodableValue()});
    }
    std::string version(value);
    free(value);
    return flutter::EncodableValue(
        flutter::EncodableList{flutter::EncodableValue(version)});
  }
};

}  // namespace

void {{pluginClass}}RegisterWithRegistrar(
    FlutterDesktopPluginRegistrarRef registrar) {
  {{pluginClass}}::RegisterWithRegistrar(
      flutter::PluginRegistrarManager::GetInstance()
          ->GetRegistrar<flutter::PluginRegistrar>(registrar));
}
