set -e

kill_gdbserver_if_running() {
  current_attr="$(cat /proc/self/attr/current)" || return 0
  case "$current_attr" in
    User::Pkg::*) ;;
    *) return 0 ;;
  esac
  ps -eZ | grep "$current_attr" | while read -r line; do
    pid="$(printf '%s\n' "$line" | awk '{print $2}')"
    cmd="$(printf '%s\n' "$line" | awk '{print $NF}')"
    if [ "$cmd" = "<defunct>" ] || [ "$cmd" = "gdbserver_real" ]; then
      kill "$pid"
    fi
  done
}

kill_gdbserver_if_running

SCRIPT_DIR="$(dirname "$0")"
"$SCRIPT_DIR/gdbserver_real" "$@"
